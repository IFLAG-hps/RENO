{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProductionDynamoDBAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:DescribeTable",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-1:${ACCOUNT_ID}:table/reno-mvp-prod-*",
        "arn:aws:dynamodb:ap-northeast-1:${ACCOUNT_ID}:table/reno-mvp-prod-*/index/*"
      ]
    },
    {
      "Sid": "ProductionS3BucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::reno-mvp-prod-*"
    },
    {
      "Sid": "ProductionS3ObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::reno-mvp-prod-*/*"
    },
    {
      "Sid": "ProductionCognitoAccess",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:GetUser"
      ],
      "Resource": "*"
    }
  ]
}
