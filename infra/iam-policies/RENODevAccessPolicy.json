{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DevImageGenerationQueueAccess",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:ap-northeast-1:${ACCOUNT_ID}:reno-mvp-dev-*"
    },
    {
      "Sid": "DevDynamoDBAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:DescribeTable",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-1:${ACCOUNT_ID}:table/reno-mvp-dev-*",
        "arn:aws:dynamodb:ap-northeast-1:${ACCOUNT_ID}:table/reno-mvp-dev-*/index/*"
      ]
    },
    {
      "Sid": "DevS3BucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::reno-mvp-dev-*"
    },
    {
      "Sid": "DevS3ObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::reno-mvp-dev-*/*"
    },
    {
      "Sid": "DevCognitoAccess",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:GetUser"
      ],
      "Resource": "*"
    }
  ]
}
